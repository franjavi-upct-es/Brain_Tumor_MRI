.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (tracked by DVC, not Git)
data/raw/
data/processed/
data/splits/

# Model outputs (tracked by DVC)
outputs/models/
outputs/metrics/
outputs/evaluation/
outputs/figures/
outputs/logs/

# DVC local cache
/dvc.lock

# Weights & Biases
wandb/

# Coverage reports
htmlcov/
.coverage
coverage.xml

# Linting
.ruff_cache/

# pytest
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Synapse
.synapseCache/
